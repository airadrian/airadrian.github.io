---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
	<h1>Hey, ich bin Adrian</h1>
	<p>
		Basketballer, Gamer, Serienaddict und jetzt auch Blogger!
	</p>
	<p>
		Dieser Blog führt euch durch meine Gedanken, Ideen und Projekte. Egal ob Meinungen, Reviews oder einfach nur wilde Gedanken, hier findest du alles!
	</p>

	<h2>Was ich gerade mache</h2>
	<p>Visionquest gucken, Valheim spielen, NBA gucken und meine erste Blogreihe planen </p>

	<h2>Was bald kommt</h2>
	<p>Review zu Visionquest Folge 1 und 2, Valheim Experience und eine Prediction zu den NBA PPlayoffs diese Season</p>

	<ul>
		<li><a href="/about">Mehr über mich</a></li>
		<li><a href="/blog">Der Blog</a></li>
	</ul>

	<img
		src="/buttons/kills-fascists.png"  
		alt="This website kills fascist"
		width="88"
		height="31"
	/>
</main>
		<Footer />
	</body>
</html>
